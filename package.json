{
  "name": "tabpalette",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "JJLIM00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JJLIM00/TabPalette.git"
  },
  "bugs": {
    "url": "https://github.com/JJLIM00/TabPalette/issues"
  },
  "homepage": "https://github.com/JJLIM00/TabPalette#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#202124",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "tabs",
    "tab groups",
    "chrome",
    "group tabs",
    "organize tabs",
    "tab colors",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tabPalette.addToGroup",
        "title": "%command.addToGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.addToNewGroup",
        "title": "%command.addToNewGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.removeFromGroup",
        "title": "%command.removeFromGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.moveToGroup",
        "title": "%command.moveToGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.addSelectedToGroup",
        "title": "%command.addSelectedToGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.addSelectedToNewGroup",
        "title": "%command.addSelectedToNewGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.removeSelectedFromGroup",
        "title": "%command.removeSelectedFromGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.editGroup",
        "title": "%command.editGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.renameGroup",
        "title": "%command.renameGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.changeColor",
        "title": "%command.changeColor%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.toggleCollapse",
        "title": "%command.toggleCollapse%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.newTabInGroup",
        "title": "%command.newTabInGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.moveGroupToNewWindow",
        "title": "%command.moveGroupToNewWindow%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.closeGroup",
        "title": "%command.closeGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.openGroup",
        "title": "%command.openGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.ungroup",
        "title": "%command.ungroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.deleteGroup",
        "title": "%command.deleteGroup%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.showMenu",
        "title": "%command.showMenu%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.enablePatch",
        "title": "%command.enablePatch%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.disablePatch",
        "title": "%command.disablePatch%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.reloadPatch",
        "title": "%command.reloadPatch%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.openToSide",
        "title": "%command.tab.openToSide%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.revealInExplorer",
        "title": "%command.tab.revealInExplorer%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.revealInFinder",
        "title": "%command.tab.revealInFinder%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.openContainingFolder",
        "title": "%command.tab.openContainingFolder%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.copyPath",
        "title": "%command.tab.copyPath%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.copyRelativePath",
        "title": "%command.tab.copyRelativePath%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.reopenWith",
        "title": "%command.tab.reopenWith%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.save",
        "title": "%command.tab.save%",
        "category": "%category%",
        "enablement": "tabDirty"
      },
      {
        "command": "tabPalette.tab.revert",
        "title": "%command.tab.revert%",
        "category": "%category%",
        "enablement": "tabDirty"
      },
      {
        "command": "tabPalette.tab.compareWithSaved",
        "title": "%command.tab.compareWithSaved%",
        "category": "%category%",
        "enablement": "tabDirty"
      },
      {
        "command": "tabPalette.tab.compareWithSelected",
        "title": "%command.tab.compareWithSelected%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.selectForCompare",
        "title": "%command.tab.selectForCompare%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.close",
        "title": "%command.tab.close%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.closeOthers",
        "title": "%command.tab.closeOthers%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.closeSaved",
        "title": "%command.tab.closeSaved%",
        "category": "%category%"
      },
      {
        "command": "tabPalette.tab.closeAll",
        "title": "%command.tab.closeAll%",
        "category": "%category%"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "tabPalette.addToGroup",
          "group": "1_tabpalette@1",
          "when": "!multipleEditorsSelectedInGroup && resource not in tabPalette.groupedUris"
        },
        {
          "command": "tabPalette.addToNewGroup",
          "group": "1_tabpalette@2",
          "when": "!multipleEditorsSelectedInGroup && resource not in tabPalette.groupedUris"
        },
        {
          "submenu": "tabPalette.tabSubmenu",
          "group": "1_tabpalette@1",
          "when": "!multipleEditorsSelectedInGroup && resource in tabPalette.groupedUris"
        },
        {
          "command": "tabPalette.addSelectedToGroup",
          "group": "1_tabpalette@1",
          "when": "multipleEditorsSelectedInGroup"
        },
        {
          "command": "tabPalette.addSelectedToNewGroup",
          "group": "1_tabpalette@2",
          "when": "multipleEditorsSelectedInGroup"
        },
        {
          "command": "tabPalette.removeSelectedFromGroup",
          "group": "1_tabpalette@3",
          "when": "multipleEditorsSelectedInGroup"
        }
      ],
      "tabPalette.tabSubmenu": [
        {
          "command": "tabPalette.moveToGroup",
          "group": "1_tab@1"
        },
        {
          "command": "tabPalette.removeFromGroup",
          "group": "1_tab@2"
        },
        {
          "command": "tabPalette.editGroup",
          "group": "2_group@1"
        },
        {
          "command": "tabPalette.toggleCollapse",
          "group": "2_group@2"
        },
        {
          "command": "tabPalette.newTabInGroup",
          "group": "2_group@3"
        },
        {
          "command": "tabPalette.moveGroupToNewWindow",
          "group": "2_group@4"
        },
        {
          "command": "tabPalette.closeGroup",
          "group": "2_group@5"
        },
        {
          "command": "tabPalette.ungroup",
          "group": "3_cancel@1"
        },
        {
          "command": "tabPalette.deleteGroup",
          "group": "3_cancel@2"
        }
      ],
      "explorer/context": [
        {
          "command": "tabPalette.addToGroup",
          "group": "7_tabpalette@1",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "tabPalette.moveToGroup",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.openToSide",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.revealInExplorer",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.revealInFinder",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.openContainingFolder",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.copyPath",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.copyRelativePath",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.reopenWith",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.save",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.revert",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.compareWithSaved",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.compareWithSelected",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.selectForCompare",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.close",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.closeOthers",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.closeSaved",
          "when": "false"
        },
        {
          "command": "tabPalette.tab.closeAll",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "tabPalette.addToGroup",
          "group": "1_tabgroups@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'tab'"
        },
        {
          "command": "tabPalette.addToNewGroup",
          "group": "1_tabgroups@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'tab'"
        },
        {
          "command": "tabPalette.moveToGroup",
          "group": "1_tabgroups@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'groupedTab'"
        },
        {
          "command": "tabPalette.removeFromGroup",
          "group": "1_tabgroups@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'groupedTab'"
        },
        {
          "command": "tabPalette.addSelectedToGroup",
          "group": "1_tabgroups@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'selectedTabs'"
        },
        {
          "command": "tabPalette.addSelectedToNewGroup",
          "group": "1_tabgroups@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'selectedTabs'"
        },
        {
          "command": "tabPalette.removeSelectedFromGroup",
          "group": "1_tabgroups@3",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'selectedTabs'"
        },
        {
          "command": "tabPalette.tab.openToSide",
          "group": "2_open@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab'"
        },
        {
          "command": "tabPalette.tab.revealInExplorer",
          "group": "2_open@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme == 'file' && isWindows"
        },
        {
          "command": "tabPalette.tab.revealInFinder",
          "group": "2_open@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme == 'file' && isMac"
        },
        {
          "command": "tabPalette.tab.openContainingFolder",
          "group": "2_open@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme == 'file' && isLinux"
        },
        {
          "command": "tabPalette.tab.copyPath",
          "group": "3_copy@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab'"
        },
        {
          "command": "tabPalette.tab.copyRelativePath",
          "group": "3_copy@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab'"
        },
        {
          "command": "tabPalette.tab.reopenWith",
          "group": "4_reopen@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab'"
        },
        {
          "command": "tabPalette.tab.save",
          "group": "5_save@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab'"
        },
        {
          "command": "tabPalette.tab.revert",
          "group": "5_save@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab'"
        },
        {
          "command": "tabPalette.tab.compareWithSaved",
          "group": "6_compare@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab'"
        },
        {
          "command": "tabPalette.tab.compareWithSelected",
          "group": "6_compare@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab' && resourceSelectedForCompare"
        },
        {
          "command": "tabPalette.tab.selectForCompare",
          "group": "6_compare@3",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/ && tabScheme != 'tabpalette-tab'"
        },
        {
          "command": "tabPalette.tab.close",
          "group": "7_close@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/"
        },
        {
          "command": "tabPalette.tab.closeOthers",
          "group": "7_close@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/"
        },
        {
          "command": "tabPalette.tab.closeSaved",
          "group": "7_close@3",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/"
        },
        {
          "command": "tabPalette.tab.closeAll",
          "group": "7_close@4",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection =~ /^(tab|groupedTab)$/"
        },
        {
          "command": "tabPalette.openGroup",
          "group": "1_closed@1",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'closedGroup'"
        },
        {
          "command": "tabPalette.deleteGroup",
          "group": "1_closed@2",
          "when": "webviewId == 'tabPalette.sidebar' && webviewSection == 'closedGroup'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tabPalette.addToGroup",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "tabPalette.addSelectedToGroup",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "multipleEditorsSelectedInGroup"
      },
      {
        "command": "tabPalette.closeGroup",
        "key": "ctrl+alt+shift+w",
        "mac": "cmd+alt+shift+w"
      },
      {
        "command": "tabPalette.showMenu",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "colors": [
      {
        "id": "tabPalette.color1",
        "description": "%color.color1%",
        "defaults": {
          "dark": "#DADCE0",
          "light": "#5F6368",
          "highContrast": "#DADCE0",
          "highContrastLight": "#5F6368"
        }
      },
      {
        "id": "tabPalette.color2",
        "description": "%color.color2%",
        "defaults": {
          "dark": "#8AB4F8",
          "light": "#1A73E8",
          "highContrast": "#8AB4F8",
          "highContrastLight": "#1A73E8"
        }
      },
      {
        "id": "tabPalette.color3",
        "description": "%color.color3%",
        "defaults": {
          "dark": "#F28B82",
          "light": "#D93025",
          "highContrast": "#F28B82",
          "highContrastLight": "#D93025"
        }
      },
      {
        "id": "tabPalette.color4",
        "description": "%color.color4%",
        "defaults": {
          "dark": "#FDD663",
          "light": "#E37400",
          "highContrast": "#FDD663",
          "highContrastLight": "#E37400"
        }
      },
      {
        "id": "tabPalette.color5",
        "description": "%color.color5%",
        "defaults": {
          "dark": "#81C995",
          "light": "#1E8E3E",
          "highContrast": "#81C995",
          "highContrastLight": "#1E8E3E"
        }
      },
      {
        "id": "tabPalette.color6",
        "description": "%color.color6%",
        "defaults": {
          "dark": "#FF8BCB",
          "light": "#D01884",
          "highContrast": "#FF8BCB",
          "highContrastLight": "#D01884"
        }
      },
      {
        "id": "tabPalette.color7",
        "description": "%color.color7%",
        "defaults": {
          "dark": "#C58AF9",
          "light": "#9334E6",
          "highContrast": "#C58AF9",
          "highContrastLight": "#9334E6"
        }
      },
      {
        "id": "tabPalette.color8",
        "description": "%color.color8%",
        "defaults": {
          "dark": "#78D9EC",
          "light": "#007B83",
          "highContrast": "#78D9EC",
          "highContrastLight": "#007B83"
        }
      },
      {
        "id": "tabPalette.color9",
        "description": "%color.color9%",
        "defaults": {
          "dark": "#FCAD70",
          "light": "#C26401",
          "highContrast": "#FCAD70",
          "highContrastLight": "#C26401"
        }
      },
      {
        "id": "tabPalette.ungroupDropLine",
        "description": "%color.ungroupDropLine%",
        "defaults": {
          "dark": "#F14C4C",
          "light": "#E51400",
          "highContrast": "#F14C4C",
          "highContrastLight": "#E51400"
        }
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "tabPalette.tabBar.activeTabOutline": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "%setting.tabBar.activeTabOutline%"
        },
        "tabPalette.tabBar.chipMaxWidth": {
          "type": "number",
          "default": 160,
          "minimum": 40,
          "maximum": 400,
          "order": 2,
          "markdownDescription": "%setting.tabBar.chipMaxWidth%"
        },
        "tabPalette.groupColors.color1": {
          "type": "string",
          "default": "#DADCE0",
          "format": "color-hex",
          "order": 10,
          "markdownDescription": "%setting.groupColors.color1%"
        },
        "tabPalette.groupColors.color2": {
          "type": "string",
          "default": "#8AB4F8",
          "format": "color-hex",
          "order": 11,
          "markdownDescription": "%setting.groupColors.color2%"
        },
        "tabPalette.groupColors.color3": {
          "type": "string",
          "default": "#F28B82",
          "format": "color-hex",
          "order": 12,
          "markdownDescription": "%setting.groupColors.color3%"
        },
        "tabPalette.groupColors.color4": {
          "type": "string",
          "default": "#FDD663",
          "format": "color-hex",
          "order": 13,
          "markdownDescription": "%setting.groupColors.color4%"
        },
        "tabPalette.groupColors.color5": {
          "type": "string",
          "default": "#81C995",
          "format": "color-hex",
          "order": 14,
          "markdownDescription": "%setting.groupColors.color5%"
        },
        "tabPalette.groupColors.color6": {
          "type": "string",
          "default": "#FF8BCB",
          "format": "color-hex",
          "order": 15,
          "markdownDescription": "%setting.groupColors.color6%"
        },
        "tabPalette.groupColors.color7": {
          "type": "string",
          "default": "#C58AF9",
          "format": "color-hex",
          "order": 16,
          "markdownDescription": "%setting.groupColors.color7%"
        },
        "tabPalette.groupColors.color8": {
          "type": "string",
          "default": "#78D9EC",
          "format": "color-hex",
          "order": 17,
          "markdownDescription": "%setting.groupColors.color8%"
        },
        "tabPalette.groupColors.color9": {
          "type": "string",
          "default": "#FCAD70",
          "format": "color-hex",
          "order": 18,
          "markdownDescription": "%setting.groupColors.color9%"
        },
        "tabPalette.ungroupDropLineColor": {
          "type": "string",
          "default": "#F14C4C",
          "format": "color-hex",
          "order": 19,
          "markdownDescription": "%setting.ungroupDropLineColor%"
        }
      }
    },
    "submenus": [
      {
        "id": "tabPalette.tabSubmenu",
        "label": "%submenu.tabSubmenu%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tabPalette",
          "title": "%viewsContainer.tabGroups%",
          "icon": "resources/sidebar/tabs.svg"
        }
      ]
    },
    "views": {
      "tabPalette": [
        {
          "type": "webview",
          "id": "tabPalette.sidebar",
          "name": "%view.sidebar%"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "pnpm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "pretest": "pnpm run check-l10n && pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/JJLIM00/TabPalette/HEAD/",
    "publish": "vsce publish --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/JJLIM00/TabPalette/HEAD/",
    "test:ui": "pnpm run compile-tests && pnpm run compile && mocha --ui tdd --timeout 60000 \"out/test-ui/**/*.test.js\"",
    "check-l10n": "node scripts/l10n.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
